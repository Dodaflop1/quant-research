# Kalshi API credentials
KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=./certs/kalshi_private.pem

# Reddit API credentials
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT="quant_research_v1"

# Market data API credentials
POLYGON_API_KEY=your_polygon_key_here
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Database configuration
DATABASE_URL=sqlite:///./data/kalshi.db
REDDIT_DATABASE_URL=sqlite:///./data/reddit.db
MARKET_DATA_PATH=./data/market.parquet

# Logging configuration
LOG_LEVEL=INFO
LOG_PATH=./logs/

# Application settings
ENVIRONMENT=development
DEBUG=false

# Optional: turns natural-language hypotheses into a reviewable schema.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
